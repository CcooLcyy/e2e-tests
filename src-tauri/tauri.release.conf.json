{
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      ".bundle/runtime/.mskdsp-testbench-runtime": "runtime/.mskdsp-testbench-runtime",
      ".bundle/runtime/suite/": "runtime/suite/"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
